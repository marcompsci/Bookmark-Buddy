<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registers bookmarkbuddy:// so Supabase email links (sign-up confirmation,
	     password reset) and OAuth callbacks open the app. Merged with the
	     settings Xcode generates (GENERATE_INFOPLIST_FILE = YES). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Bookmark Buddy auth callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bookmarkbuddy</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
